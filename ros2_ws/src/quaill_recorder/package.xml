<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>quaill_recorder</name>
  <version>0.0.2</version>
  <description>Sidecar nodes that make a plain `ros2 bag record` produce a log the Quaill checker can grade: hash-chain links, control-mode reports, session markers, witness heads.</description>
  <maintainer email="254507736+Deseace@users.noreply.github.com">Quaill</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>quaill_msgs</depend>
  <depend>std_msgs</depend>
  <depend>builtin_interfaces</depend>
  <depend>rosidl_runtime_py</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
